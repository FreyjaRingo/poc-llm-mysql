# Salin file ini menjadi .env lalu sesuaikan. Jangan pernah membagikan file .env.

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=classicmodels
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
DB_READER_USER=llm_reader
DB_READER_PASSWORD=ganti_password_ini

# ---- DeepSeek ----
DEEPSEEK_API_KEY=isi_api_key_anda
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# disabled atau enabled
LLM_THINKING=disabled
# Tidak berpengaruh saat LLM_THINKING=enabled
LLM_TEMPERATURE=0

# ---- Batas eksekusi ----
MAX_ROWS=200
QUERY_TIMEOUT_MS=10000

# ---- Saklar eksperimen ----
INCLUDE_COLUMN_COMMENTS=true
INCLUDE_BUSINESS_RULES=false
SEND_ROWS_TO_LLM=true
ROWS_SENT_TO_LLM=30
